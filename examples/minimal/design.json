  "decisions": [
    {
      "id": "D-1",
      "title": "Primary store",
      "context": "Domain records need durable, queryable storage.",
      "options": [
        {
          "name": "PostgreSQL",
          "pros": [
            "transactions",
            "indexes and JSON",
            "already available"
          ],
          "cons": [
            "operational dependency"
          ]
        },
        {
          "name": "SQLite",
          "pros": [
            "zero operations",
            "single file"
          ],
          "cons": [
            "one writer at a time",
            "no network access"
          ]
        },
        {
          "name": "Files (JSON/CSV on disk)",
          "pros": [
            "no dependencies",
            "human readable"
          ],
          "cons": [
            "no transactions or concurrency"
          ]
        },
        {
          "name": "In-memory",
          "pros": [
            "fastest",
            "trivial"
          ],
          "cons": [
            "lost on restart"
          ]
        }
      ],
      "choice": "SQLite",
      "rationale": "Scored against the active qualities; decided by simplicity (no qualities stated). SQLite: 3.00; Files: 3.00; In-memory: 3.00; PostgreSQL: unavailable (needs postgres, not in the constraints)",
      "consequences": "Not choosing 'Files' gives up: no dependencies, human readable. Not choosing 'In-memory' gives up: fastest, trivial.",
      "affects": [
        "C-1"
      ],
      "status": "accepted"
    }
  ],
  "risks": [
    {
      "id": "K-1",
      "description": "A widespread failure disables many targets and emails every owner at once.",
      "likelihood": "low",
      "impact": "medium",
      "mitigation": "Rate-limit notifications per owner and batch them.",
      "affects": [
        "C-4"
      ]
    },
    {
      "id": "K-2",
      "description": "Payloads or uploads without size limits exhaust memory or disk.",
      "likelihood": "medium",
      "impact": "medium",
      "mitigation": "Enforce size limits at the surface; reject early with a clear error.",
      "affects": [
        "C-6"
      ]
    },
    {
      "id": "K-3",
      "description": "A single-writer store becomes the ceiling under concurrent load.",
      "likelihood": "medium",
      "impact": "medium",
      "mitigation": "Keep write transactions short; measure before sharding.",
      "affects": [
        "C-1"
      ]
    },
    {
      "id": "K-4",
      "description": "[tampering] Store: Injection through query construction.",
      "likelihood": "medium",
      "impact": "medium",
      "mitigation": "Parameterised queries only; no string-built SQL. Check: static check for string-formatted SQL finds nothing",
      "affects": [
        "C-1"
      ]
    },
    {
      "id": "K-5",
      "description": "[information_disclosure] Store: Backups and dumps contain everything.",
      "likelihood": "medium",
      "impact": "high",
      "mitigation": "Encrypt backups; restrict who can take them. Check: backup file is not readable without the key",
      "affects": [
        "C-1"
      ]
    },
    {
      "id": "K-6",
      "description": "[denial_of_service] Notifier: Notification storms and template injection.",
      "likelihood": "medium",
      "impact": "medium",
      "mitigation": "Rate-limit per recipient; escape template context. Check: 1,000 failures produce one digest per owner",
      "affects": [
        "C-4"
      ]
    },
    {
      "id": "K-7",
      "description": "[spoofing] Public HTTP API: Requests without a verified caller identity reach domain operations.",
      "likelihood": "medium",
      "impact": "medium",
      "mitigation": "Authenticate every route in one middleware; deny by default. Check: every route returns 401 without credentials",
      "affects": [
        "C-6"
      ]
    },
    {
      "id": "K-8",
      "description": "[tampering] Public HTTP API: Malformed or oversized bodies reach the core.",
      "likelihood": "medium",
      "impact": "medium",
      "mitigation": "Schema-validate and size-limit at the surface; reject before parsing fully. Check: fuzz the body; oversize returns 413",
      "affects": [
        "C-6"
      ]
    },
    {
      "id": "K-9",
      "description": "[denial_of_service] Public HTTP API: A single caller saturates the service.",
      "likelihood": "medium",
      "impact": "medium",
      "mitigation": "Per-caller rate limit and request timeouts. Check: burst from one key returns 429; others unaffected",
      "affects": [
        "C-6"
      ]
    },
    {
      "id": "K-10",
      "description": "[information_disclosure] Public HTTP API: Stack traces or internal ids leak in error responses.",
      "likelihood": "medium",
      "impact": "high",
      "mitigation": "Map exceptions to fixed error shapes; log details server-side only. Check: no traceback text in any 4xx/5xx body",
      "affects": [
        "C-6"
      ]
    }
  ],
